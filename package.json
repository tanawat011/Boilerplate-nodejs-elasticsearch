{
  "name": "api-node-es6-elasticsearch",
  "version": "2.0.0",
  "description": "Node.js Restful API with modern JavaScript and Elasticsearch",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env --test"
  },
  "keywords": [
