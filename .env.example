# Copy to .env (git-ignored); `npm run serve`, `npm run dev` and `npm test`
# read it, and compose.yaml takes the password from it. DEV ONLY:
# placeholders for the local Elasticsearch. Never put real credentials here.

ELASTICSEARCH_URL=http://127.0.0.1:19200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me-dev-only
ES_PORT=19200

HEROES_INDEX=heroes

HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:4200

# The integration tests make and delete their own index with this prefix.
ELASTICSEARCH_TEST_INDEX_PREFIX=heroes-test
